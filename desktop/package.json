{
  "name": "viagens-desktop",
  "version": "1.1.1",
  "description": "Apple Stock Monitor - quatro regiões, histórico persistente e alerta sonoro",
  "main": "main.js",
  "author": "thenights20",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.thenights20.viagens",
    "productName": "Apple Stock Monitor",
    "asar": true,
    "files": ["main.js", "index.html"],
    "win": {
      "target": ["portable"],
      "artifactName": "Apple-Stock-Monitor-${version}.exe"
    }
  }
}
