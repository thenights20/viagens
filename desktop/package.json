{
  "name": "viagens-desktop",
  "version": "1.1.3",
  "description": "Apple Stock Monitor - iPhone 18 Pro Max Burgundy 256GB/512GB, histórico centralizado e alerta sonoro",
  "main": "main.js",
  "author": "thenights20",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.thenights20.viagens",
    "productName": "Apple Stock Monitor",
    "asar": true,
    "files": [
      "main.js",
      "index.html"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "Apple-Stock-Monitor-${version}.exe"
    }
  }
}
